# Settings password. Leave this empty and the password is 12345.
ADMIN_PASSWORD=

# Live player. Leave these empty and paste the addresses in Settings instead.
# Stream 2 plays when Stream 1 does not start.
STREAM_URL=
STREAM_URL_2=

# Google Drive, free Gmail path. Create a Desktop OAuth client, then:
#   GOOGLE_CLIENT_ID=... GOOGLE_CLIENT_SECRET=... npm run drive-auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Printed by npm run drive-auth after the Morning desk folder is created.
DRIVE_FOLDER_ID=

# Optional. A service account has no storage of its own, so this only works
# with a Workspace shared drive. A normal Gmail account should use the OAuth
# values above instead. Paste the JSON, or its base64.
GOOGLE_SERVICE_ACCOUNT_JSON=

# From BotFather, and the chat that should receive the audio.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Lets "Record now" on the hosted site start .github/workflows/record.yml
# Token needs Actions: Read and write. Repository is owner/name.
GITHUB_DISPATCH_TOKEN=
GITHUB_REPOSITORY=
GITHUB_DISPATCH_REF=main
